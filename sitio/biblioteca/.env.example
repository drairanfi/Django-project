# Configuración de la API de IA. settings.py lo lee solo, sin cargarlo en la shell.
# El archivo no se versiona: copialo a .env y completá con tu clave.

# Opción A: opencode-go (DeepSeek v4 flash) — OpenAI-compatible
IA_API_KEY='tu-clave-de-opencode-go'
IA_API_URL='https://opencode.ai/zen/go/v1'
IA_MODEL='deepseek-v4-flash'
IA_API_SESION='nombre-de-sesion'

# Opción B: Google Gemini (respaldo)
# IA_API_KEY='tu-clave-de-google-ai-studio'
# IA_API_URL='https://generativelanguage.googleapis.com/v1beta'
# IA_MODEL='gemini-2.5-flash'
