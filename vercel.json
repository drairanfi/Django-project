{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "sitio": {
      "root": "sitio/"
    },
    "api": {
      "root": "microservicio_resenas/",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "sitio" } }
  ]
}
